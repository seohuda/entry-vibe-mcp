{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "scripts/**/*.ts",
    "compiler/**/*.ts",
    "server/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "vendor", "test"]
}
